{
  "name": "sosc-axi",
  "version": "0.1.4",
  "description": "AXI-compliant CLI for SOS Contador - agent-ergonomic TOON output",
  "keywords": [
    "sos-contador",
    "sos contador",
    "afip",
    "arca",
    "argentina",
    "axi",
    "agent",
    "cli",
    "toon"
  ],
  "license": "MIT",
  "author": "Damián Caruso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalecaru/sosc-axi.git"
  },
  "homepage": "https://github.com/dalecaru/sosc-axi#readme",
  "type": "module",
  "bin": {
    "sosc-axi": "dist/sosc-axi.js"
  },
  "files": [
    "dist",
    "skills/sosc-axi"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun bin/sosc-axi.ts",
    "build": "rm -rf dist && bun build bin/sosc-axi.ts --target node --splitting --outdir dist",
    "build:skill": "bun scripts/build-skill.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts",
    "sync:openapi": "bun scripts/sync-openapi.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "latest",
    "@types/node": "^20",
    "axi-sdk-js": "^0.1.13",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
